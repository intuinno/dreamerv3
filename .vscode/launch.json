{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "train mmjc",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/dreamerv3/main.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                // "--configs", "top-009-rev0","debug", 
                "--configs",
                "mmjc", 
                "--logdir",
                "./logdir/debug/{timestamp}",
              //  "--run.from_checkpoint",
              //  "./dreamerv3/logs/maz-004-rev1",
            ],
            "env": {
                // "MUJOCO_GL": "glfw",
                "MUJOCO_GL": "egl",
                //   "DYLD_LIBRARY_PATH": "/opt/homebrew/lib:",
                // "XLA_PYTHON_CLIENT_ALLOCATOR": "platform",
            }
        },
        {
            "name": "play mmjc",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/play.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "--configs",
                "maz-004-rev4", 
                "--run.from_checkpoint",
                "checkpoints/maz-004-rev4-2M",
            ],
            "env": {
                // "MUJOCO_GL": "glfw",
                "MUJOCO_GL": "glfw",
                // "MUJOCO_GL": "egl",
            }
        }
    ]
}